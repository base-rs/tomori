# A session the operator started in plan mode, whose request for auto mode is refused. Condensed from Claude Code 2.1.311
# output; the account it was recorded with offers auto mode, so the refusal is built from the CLI's documented
# `set_permission_mode` error codes, in the shape of its recorded `bypass_not_launched` refusal.
expect control_request:initialize
send {"type":"control_response","response":{"subtype":"success","request_id":"{{request}}","response":{"commands":[],"agents":[],"output_style":"default","models":[],"claude_code_version":"2.1.311","current_permission_mode":"plan","session_state":"idle"}}}
expect control_request:set_permission_mode
send {"type":"control_response","response":{"subtype":"error","request_id":"{{request}}","error":"Cannot set permission mode to auto: auto mode is unavailable for your plan","error_code":"auto_mode_unavailable"}}
drain
