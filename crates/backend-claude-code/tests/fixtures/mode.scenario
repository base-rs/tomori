# A session started in auto mode and switched to plan mode, condensed from Claude Code 2.1.311 output. The agent reports
# its mode at connect in the initialize response, and confirms a change with the response and a status message.
expect control_request:initialize
send {"type":"control_response","response":{"subtype":"success","request_id":"{{request}}","response":{"commands":[],"agents":[],"output_style":"default","models":[],"claude_code_version":"2.1.311","current_permission_mode":"auto","session_state":"idle"}}}
expect control_request:set_permission_mode
send {"type":"control_response","response":{"subtype":"success","request_id":"{{request}}","response":{"mode":"plan"}}}
send {"type":"system","subtype":"status","status":null,"permissionMode":"plan","uuid":"7fc4c493-7194-4282-b2df-ca2092ccaaa6","session_id":"{{session}}"}
drain
