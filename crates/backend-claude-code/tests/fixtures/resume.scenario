# An attached session resumes a subagent its records show stopped, which finishes, then resumes another, and exits while
# it runs. Shaped like Claude Code 2.1.311 output; the records are in `records/`.
expect user
send {"type":"user","message":{"role":"user","content":"Resume the implementer."},"session_id":"{{session}}","parent_tool_use_id":null,"uuid":"{{uuid}}","isReplay":true}
send {"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_resume","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_resume_again","name":"SendMessage","input":{"to":"a2222bbbb2222bbbb","summary":"Resume the implementer","message":"Please carry on."}}],"stop_reason":null},"parent_tool_use_id":null,"session_id":"{{session}}","uuid":"30000000-0000-4000-8000-000000000001"}
send {"type":"system","subtype":"task_started","task_id":"a2222bbbb2222bbbb","run_id":"0mvz00000-00000003","tool_use_id":"toolu_resume_again","description":"Implement the design","subagent_type":"general-purpose","is_backgrounded":true,"spawn_depth":1,"task_type":"local_agent","uuid":"30000000-0000-4000-8000-000000000002","session_id":"{{session}}"}
send {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_resume_again","type":"tool_result","content":[{"type":"text","text":"{\"success\":true,\"message\":\"Resuming agent a2222bb\",\"resumedAgentId\":\"a2222bbbb2222bbbb\"}"}]}]},"parent_tool_use_id":null,"session_id":"{{session}}","uuid":"30000000-0000-4000-8000-000000000003","tool_use_result":{"success":true,"message":"Resuming agent a2222bb","resumedAgentId":"a2222bbbb2222bbbb","revivedAgentId":"a2222bbbb2222bbbb"}}
send {"type":"result","subtype":"success","is_error":false,"num_turns":1,"result":"Resumed.","stop_reason":"end_turn","session_id":"{{session}}","terminal_reason":"completed","uuid":"30000000-0000-4000-8000-000000000004"}
send {"type":"system","subtype":"task_updated","task_id":"a2222bbbb2222bbbb","run_id":"0mvz00000-00000003","patch":{"status":"completed","end_time":1793415271102},"uuid":"30000000-0000-4000-8000-000000000005","session_id":"{{session}}"}
send {"type":"system","subtype":"task_notification","task_id":"a2222bbbb2222bbbb","run_id":"0mvz00000-00000003","tool_use_id":"toolu_resume_again","status":"completed","output_file":"","summary":"Agent \"Implement the design\" finished","uuid":"30000000-0000-4000-8000-000000000006","session_id":"{{session}}"}
expect user
send {"type":"user","message":{"role":"user","content":"Resume the test writer."},"session_id":"{{session}}","parent_tool_use_id":null,"uuid":"{{uuid}}","isReplay":true}
send {"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_tests","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_tests_again","name":"SendMessage","input":{"to":"a3333cccc3333cccc","summary":"More tests","message":"Add one more test."}}],"stop_reason":null},"parent_tool_use_id":null,"session_id":"{{session}}","uuid":"30000000-0000-4000-8000-000000000007"}
send {"type":"system","subtype":"task_started","task_id":"a3333cccc3333cccc","run_id":"0mvz00001-00000004","tool_use_id":"toolu_tests_again","description":"Write the tests","subagent_type":"general-purpose","is_backgrounded":true,"spawn_depth":1,"task_type":"local_agent","uuid":"30000000-0000-4000-8000-000000000008","session_id":"{{session}}"}
stderr Error: the process was killed
exit 1
